  "item": [
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categorias"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('el Content-Type es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('es una página con content y page', () => {",
                  "    pm.expect(cuerpo.content).to.be.an('array');",
                  "    pm.expect(cuerpo.page).to.include.all.keys('size', 'number', 'totalElements', 'totalPages');",
                  "});",
                  "pm.test('cada categoría tiene id, nombre y habilitada', () => cuerpo.content.forEach(c => {",
                  "    pm.expect(c.id).to.be.a('number');",
                  "    pm.expect(c.nombre).to.be.a('string');",
                  "    pm.expect(c.habilitada).to.be.a('boolean');",
                  "}));",
                  "// Los pedidos siguientes usan una categoría que existe, sin escribir ids en la colección.",
                  "pm.collectionVariables.set('categoriaId', cuerpo.content.length ? cuerpo.content[0].id : '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Categoría por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categorias",
                "{{categoriaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('categoriaId')) {",
                  "    console.log('No hay categoriaId en los datos: se saltea este pedido');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('el Content-Type es JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('es la categoría pedida', () => {",
                  "    pm.expect(cuerpo.id).to.eql(Number(pm.collectionVariables.get('categoriaId')));",
                  "    pm.expect(cuerpo.nombre).to.be.a('string').and.not.empty;",
                  "    pm.expect(cuerpo.habilitada).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        },
