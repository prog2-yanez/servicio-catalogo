{
  "info": {
    "_postman_id": "0cfe3860-9b01-54f9-a8bc-a5ece0dcbcbe",
    "name": "Servicio de catálogo",
    "description": "Prueba la API del catálogo de punta a punta, con el servicio levantado. Las variables baseUrl y token salen del environment; los ids se toman de las respuestas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// El token se manda solo si el environment lo trae (el catálogo lo va a exigir con la #19).",
          "const token = pm.environment.get('token');",
          "if (token) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
